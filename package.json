{
  "name": "pi-debug-mode",
  "version": "1.0.0",
  "description": "pi extension — bounded ring-buffer trace of lifecycle and provider events, flushed to disk when a session is disrupted",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src/",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "debug",
    "trace",
    "tracing",
    "ring-buffer",
    "timeout"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
